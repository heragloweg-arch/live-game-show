# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LiveKit (client debug only — tokens from Edge Function)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Feature flags
VITE_ANALYTICS_ENABLED=false

# App
VITE_APP_NAME=قدها
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Billing (staging only — never true in production stores)
VITE_ALLOW_DEV_BILLING=false

# Analytics (PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# AdMob
VITE_ADS_ENABLED=false
VITE_ADS_SIMULATE=false
VITE_ADMOB_TEST=true
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=

# Firebase Analytics (optional alongside PostHog)
VITE_FIREBASE_MEASUREMENT_ID=

VITE_SENTRY_DSN=

# Google Play / production server verification (set only in Supabase secrets or CI)
GOOGLE_PLAY_PACKAGE_NAME=com.qaddaha.challenges
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
ALLOW_UNVERIFIED_PLAY_PURCHASES=false

# Android release signing (never commit; pass only to CI)
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
