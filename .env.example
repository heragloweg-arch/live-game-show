# Supabase — client-side public values only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LiveKit (public websocket URL only; access tokens are issued by Edge Function)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Feature flags
VITE_ENABLE_LOCAL_DEMO=false
VITE_ANALYTICS_ENABLED=false

# App
VITE_APP_NAME=قدها
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Billing — development shortcuts must remain false for production
VITE_ALLOW_DEV_BILLING=false
ALLOW_DEV_BILLING=false
ALLOW_UNVERIFIED_PLAY_PURCHASES=false

# Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_FIREBASE_MEASUREMENT_ID=
VITE_SENTRY_DSN=

# AdMob — leave ads disabled until real production IDs and consent flow are configured
VITE_ADS_ENABLED=false
VITE_ADS_SIMULATE=false
VITE_ADMOB_TEST=true
VITE_ADMOB_APP_ID=
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=

# Google Play / RTDN — server-only secrets; set in a secure server/Edge Function environment.
# Never expose these as VITE_* values or commit real values.
GOOGLE_PLAY_PACKAGE_NAME=com.qaddaha.challenges
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=

# Android release signing — never commit real values
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
