{
  "name": "qaddaha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "قدها — Soft-Launch Candidate (Arabic live challenge game)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 50",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "cap:android": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "android:build": "npm run build && npx cap sync android",
    "android:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:sync-billing": "npm run build && npx cap sync android",
    "postinstall": "node -e \"console.log('[qaddaha] npm i done — for APK: npm run build && npx cap sync android')\"",
    "start": "npx --yes serve -s dist -l tcp://0.0.0.0:${PORT:-3000}",
    "railway:build": "npm install --legacy-peer-deps && npm run build",
    "android:deps": "npm install && npx cap sync android",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@livekit/components-react": "^2.6.0",
    "@supabase/supabase-js": "^2.45.4",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.1",
    "livekit-client": "^2.5.1",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.3",
    "zustand": "^5.0.0",
    "serve": "^14.2.4",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capgo/native-purchases": "^6.0.0",
    "@capacitor-community/admob": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "eslint": "^9.12.0",
    "@eslint/js": "^9.12.0",
    "typescript-eslint": "^8.8.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
