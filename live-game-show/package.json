{
  "name": "qaddaha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "قدها — تطبيق تحديات وأسئلة عربية سينمائي مع Host وغرف وصوت ودوري أبطال.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "cap:android": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "android:build": "npm run build && npx cap sync android",
    "android:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:sync-billing": "npm run build && npx cap sync android",
    "postinstall": "echo \"[zatona] Run npx cap sync android after install on device machine\"",
    "start": "npx serve -s dist -l tcp://0.0.0.0:$PORT",
    "railway:build": "npm install --legacy-peer-deps && npm run build"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@livekit/components-react": "^2.6.0",
    "@supabase/supabase-js": "^2.45.4",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.1",
    "livekit-client": "^2.5.1",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.3",
    "zustand": "^5.0.0",
    "serve": "^14.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capgo/native-purchases": "^6.0.0"
  }
}
