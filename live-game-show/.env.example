# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LiveKit (client debug only — tokens from Edge Function)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Feature flags
# Set true ONLY on developer machines to allow local solo-demo engine
VITE_ENABLE_LOCAL_DEMO=false
VITE_ANALYTICS_ENABLED=false

# App
VITE_APP_NAME=قدها
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=development

# Billing (staging only — never true in production stores)
VITE_ALLOW_DEV_BILLING=false
