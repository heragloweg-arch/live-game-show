{
  "name": "qaddaha",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "قدها — Soft-Launch Candidate (Arabic live challenge game)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 50",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "cap:android": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:add:android": "npx cap add android",
    "android:build": "npm run build && npx cap sync android",
    "android:release": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:sync-billing": "npm run build && npx cap sync android",
    "postinstall": "node -e \"console.log('[qaddaha] npm i done — for APK: npm run build && npx cap sync android')\"",
    "start": "node scripts/verify-runtime-config.mjs && node scripts/write-runtime-config.mjs && node scripts/static-server.mjs",
    "railway:build": "npm ci --legacy-peer-deps && npm run build",
    "android:deps": "npm install && npx cap sync android",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:production": "npm run build && node scripts/verify-production.mjs",
    "verify:launch-config": "node scripts/verify-launch-config.mjs",
    "verify:content-release": "node scripts/verify-content-release.mjs",
    "verify:solo-progression": "node scripts/verify-solo-progression.mjs",
    "content:approve-batch": "node scripts/approve-content-batch.mjs",
    "content:import-bank": "node scripts/import-question-bank.mjs content/question-bank/source/bank.zip content/question-bank",
    "content:audit-wording": "python3 scripts/audit-question-wording.py content/question-bank/review-queue.json content/question-bank/wording-audit.json",
    "content:apply-wording": "python3 scripts/apply-wording-audit.py content/question-bank/wording-audit.json content/question-bank/wording-reviewed-queue.json && npm run content:import-bank",
    "verify:runtime-config": "node scripts/verify-runtime-config.mjs",
    "test:production-gates": "node --test scripts/production-gate.test.mjs scripts/atomic-round-advance.test.mjs scripts/security-regression.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/keyboard": "^6.0.2",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capgo/native-purchases": "^6.0.0",
    "@livekit/components-react": "^2.6.0",
    "@supabase/supabase-js": "^2.45.4",
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.1",
    "livekit-client": "^2.5.1",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.447.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.4",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "^2.5.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@eslint/js": "^9.12.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
